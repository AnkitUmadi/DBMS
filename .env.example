# Copy to .env.local and fill in real values. Never commit .env.local.

# Low-privilege app role, subject to Row-Level Security (added in Phase 2).
DATABASE_URL=postgres://finshield_app:CHANGE_ME@localhost:5432/finshield

# Schema-owning role, used only by db/migrate.sh. Not used by the Next.js app.
MIGRATE_DATABASE_URL=postgres://finshield_migrator:CHANGE_ME@localhost:5432/finshield

# MongoDB connection string for Phase 3 high-velocity spend logging (daily_expenses).
MONGODB_URI=mongodb://localhost:27017/finshield
